{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ophelia-correspondence",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "vars": {
    "SITE_ORIGIN": "https://opheliasopenbooks.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ophelia-correspondence",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
